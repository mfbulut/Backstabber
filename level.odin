    28  = {0, 0},   // {E, S, SE}
    80  = {7, 0},   // {S, W}
    112 = {2, 0},   // {S, W, SW}
    65  = {7, 3},   // {N, W}
    193 = {2, 2},   // {N, W, NW}
    84  = {8, 0},   // {E, S, W}
    92  = {6, 0},   // {E, S, W, SE}
    116 = {5, 0},   // {E, S, W, SW}
    124 = {1, 0},   // {E, S, W, SW, SE}
    21  = {4, 4},   // {N, E, S}
    23  = {4, 1},   // {N, E, S, NE}
    29  = {4, 2},   // {N, E, S, SE}
    31  = {0, 1},   // {N, E, S, NE, SE}
    81  = {7, 4},   // {N, S, W}
    113 = {7, 2},   // {N, S, W, SW}
    209 = {7, 1},   // {N, S, W, NW}
    241 = {2, 1},   // {N, S, W, NW, SW}
    69  = {8, 3},   // {N, E, W}
    71  = {6, 3},   // {N, E, W, NE}
    197 = {5, 3},   // {N, E, W, NW}
    199 = {1, 2},   // {N, E, W, NW, NE}
    85  = {8, 4},   // {N, E, S, W}
    87  = {9, 3},   // {N, E, S, W, NE}
    93  = {9, 2},   // {N, E, S, W, SE}
    95  = {6, 4},   // {N, E, S, W, NE, SE}
    117 = {10, 2},  // {N, E, S, W, SW}
    119 = {9, 1},   // {N, E, S, W, NE, SW}
    125 = {8, 2},   // {N, E, S, W, SE, SW}
    127 = {6, 2},   // {N, E, S, W, NE, SE, SW}
    213 = {10, 3},  // {N, E, S, W, NW}
    215 = {8, 1},   // {N, E, S, W, NE, NW}
    221 = {9, 0},   // {N, E, S, W, SE, NW}
    223 = {6, 1},   // {N, E, S, W, NE, SE, NW}
    245 = {5, 4},   // {N, E, S, W, SW, NW}
    247 = {5, 1},   // {N, E, S, W, NE, SW, NW}
    253 = {5, 2},   // {N, E, S, W, SE, SW, NW}
    255 = {1, 1},   // {N, E, S, W, NE, SE, SW, NW}
}

draw_level :: proc() {
    h := len(level_map)
    if h == 0 do return
    w := len(level_map[0])

    screen   := k2.get_screen_size()
    view_min := camera.target
    view_max := camera.target + screen / camera.zoom

    col_min := max(0,   int(math.floor(view_min.x / TILE_SIZE)))
    col_max := min(w-1, int(math.floor(view_max.x / TILE_SIZE)))
    row_min := max(0,   int(math.floor(view_min.y / TILE_SIZE)))
    row_max := min(h-1, int(math.floor(view_max.y / TILE_SIZE)))

    for row in row_min..=row_max {
        for col in col_min..=col_max {
            ch := level_map[row][col]

            x    := f32(col) * TILE_SIZE
            y    := f32(row) * TILE_SIZE
            dest := k2.Rect{x, y, TILE_SIZE, TILE_SIZE}

            has_N  := row > 0   && level_map[row-1][col] == '#'
            has_E  := col < w-1 && level_map[row][col+1] == '#'
            has_S  := row < h-1 && level_map[row+1][col] == '#'
            has_W  := col > 0   && level_map[row][col-1] == '#'
            has_NW := row > 0   && col > 0   && level_map[row-1][col-1] == '#' && has_N && has_W
            has_NE := row > 0   && col < w-1 && level_map[row-1][col+1] == '#' && has_N && has_E
            has_SE := row < h-1 && col < w-1 && level_map[row+1][col+1] == '#' && has_S && has_E
            has_SW := row < h-1 && col > 0   && level_map[row+1][col-1] == '#' && has_S && has_W

            if ch == '#' {
                mask: Tile_Mask
                if has_N  do mask += {.N}
                if has_NE do mask += {.NE}
                if has_E  do mask += {.E}
                if has_SE do mask += {.SE}
                if has_S  do mask += {.S}
                if has_SW do mask += {.SW}
                if has_W  do mask += {.W}
                if has_NW do mask += {.NW}

                tile_grid := TILEMAP_TEXCOORD[transmute(u8)mask]
                TILE_SRC_SIZE : f32 = 16.0

                source := k2.Rect{
                    x = f32(tile_grid.x) * TILE_SRC_SIZE,
                    y = f32(tile_grid.y) * TILE_SRC_SIZE,
                    w = TILE_SRC_SIZE,
                    h = TILE_SRC_SIZE,
                }

                k2.draw_texture_fit(tilemap, source, dest)
            } else if ch == '^' {
                spike_color := k2.Color{200, 50, 50, 255}

                if has_S {
                    k2.draw_triangle([3]k2.Vec2{{x, y + TILE_SIZE}, {x + TILE_SIZE, y + TILE_SIZE}, {x + TILE_SIZE/2, y}}, spike_color)
                } else if has_N {
                    k2.draw_triangle([3]k2.Vec2{{x, y}, {x + TILE_SIZE, y}, {x + TILE_SIZE/2, y + TILE_SIZE}}, spike_color)
                } else if has_E {
                    k2.draw_triangle([3]k2.Vec2{{x + TILE_SIZE, y}, {x + TILE_SIZE, y + TILE_SIZE}, {x, y + TILE_SIZE/2}}, spike_color)
                } else if has_W {
                    k2.draw_triangle([3]k2.Vec2{{x, y}, {x, y + TILE_SIZE}, {x + TILE_SIZE, y + TILE_SIZE/2}}, spike_color)
                } else {
                    cx := x + TILE_SIZE/2.0
                    cy := y + TILE_SIZE/2.0
                    r  := TILE_SIZE/2.2
                    ir := TILE_SIZE/6.0
                    k2.draw_triangle([3]k2.Vec2{{cx, cy - r}, {cx - ir, cy}, {cx + ir, cy}}, spike_color)
                    k2.draw_triangle([3]k2.Vec2{{cx, cy + r}, {cx + ir, cy}, {cx - ir, cy}}, spike_color)
                    k2.draw_triangle([3]k2.Vec2{{cx - r, cy}, {cx, cy + ir}, {cx, cy - ir}}, spike_color)
                    k2.draw_triangle([3]k2.Vec2{{cx + r, cy}, {cx, cy - ir}, {cx, cy + ir}}, spike_color)
                }
            } else if ch == 'X' {
                src := k2.Rect{0, 0, f32(end_sprite.width), f32(end_sprite.height)}
                t := f32(k2.get_time())
                pulse := -0.2 + 0.2 * math.sin(t * 6.0)
                dest.x += dest.w / 2
                dest.y += dest.h / 2
                k2.draw_texture_fit(end_sprite, src, dest, {dest.w / 2, dest.h / 2}, pulse)
            }
        }
    }
}

level_load :: proc(idx: int) {
    level_map = level_defs[idx]
    level_timer = 0
    player_init()
    rain_init()
    interactables_init()

    // sw := f32(k2.get_screen_size().x)
    // sh := f32(k2.get_screen_size().y)
    // zoom := min(sw / 1280.0, sh / 720.0)
    // if zoom <= 0 do zoom = 1.0
    // camera.target = player.pos - {sw / (2.0 * zoom), sh / (2.0 * zoom)}
}


