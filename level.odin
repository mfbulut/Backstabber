Level_Coords :: struct {
    player_spawn: k2.Vec2,
    exit_pos:     k2.Vec2,
    portal_pairs: [9][2]k2.Vec2,
    portal_found: [9]bool,
}

level_map:           []string
level_coords:        Level_Coords
current_level_index: int

Tile_Dir :: enum { N, NE, E, SE, S, SW, W, NW }
Tile_Mask :: bit_set[Tile_Dir; u8]

TILEMAP_TEXCOORD := [256][2]u8{
    0   = {3, 3},   // {}
    1   = {3, 2},   // {N}
    4   = {0, 3},   // {E}
    16  = {3, 0},   // {S}
    64  = {2, 3},   // {W}
    17  = {3, 1},   // {N, S}
    68  = {1, 3},   // {E, W}
    5   = {4, 3},   // {N, E}
    7   = {0, 2},   // {N, E, NE}
